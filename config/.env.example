# =============================================================================
# IdeaFlow Environment Configuration
# =============================================================================
# Copy this file to .env.local and fill in your actual values
# Never commit .env.local to version control!
# =============================================================================

# -----------------------------------------------------------------------------
# REQUIRED: Supabase Configuration
# Get these from: Supabase Dashboard → Settings → API
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# -----------------------------------------------------------------------------
# REQUIRED: AI Provider (at least one required)
# Get from: OpenAI Platform or Anthropic Console
# -----------------------------------------------------------------------------
OPENAI_API_KEY=sk-your-openai-api-key-here
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here

# -----------------------------------------------------------------------------
# REQUIRED: Cost Guardrails
# Daily spending limit in USD (prevents runaway AI costs)
# -----------------------------------------------------------------------------
COST_LIMIT_DAILY=10.0

# -----------------------------------------------------------------------------
# REQUIRED: Application URL
# Local: http://localhost:3000
# Production: https://your-domain.com
# Preview: https://your-preview.pages.dev
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# OPTIONAL: Export Integrations
# Only configure if you plan to use these features
# -----------------------------------------------------------------------------

# Notion Integration
# Get from: https://www.notion.so/my-integrations
# NOTION_API_KEY=secret_your_notion_api_key
# NOTION_CLIENT_ID=your_notion_client_id
# NOTION_CLIENT_SECRET=your_notion_client_secret
# NOTION_REDIRECT_URI=http://localhost:3000/api/auth/notion/callback
# NOTION_PARENT_PAGE_ID=your_parent_page_id

# Trello Integration
# Get from: https://trello.com/app-key
# TRELLO_API_KEY=your_trello_api_key
# TRELLO_TOKEN=your_trello_token
# TRELLO_REDIRECT_URI=http://localhost:3000/api/auth/trello/callback

# Google Tasks Integration
# Get from: Google Cloud Console → OAuth 2.0 Client IDs
# GOOGLE_CLIENT_ID=your_google_client_id
# GOOGLE_CLIENT_SECRET=your_google_client_secret
# GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
# GOOGLE_REFRESH_TOKEN=your_google_refresh_token

# GitHub Projects Integration
# Get from: GitHub Settings → Developer settings → Personal access tokens
# GITHUB_TOKEN=ghp_your_github_token
# GITHUB_CLIENT_ID=your_github_client_id
# GITHUB_CLIENT_SECRET=your_github_client_secret
# GITHUB_REDIRECT_URI=http://localhost:3000/api/auth/github/callback

# -----------------------------------------------------------------------------
# OPTIONAL: Security Configuration
# -----------------------------------------------------------------------------
# Admin API key for protected endpoints (generate with: openssl rand -base64 32)
# ADMIN_API_KEY=your_secure_admin_key_here

# Internal API secret for service-to-service communication
# INTERNAL_API_SECRET=your_internal_secret_here

# -----------------------------------------------------------------------------
# OPTIONAL: Logging Configuration
# -----------------------------------------------------------------------------
# Log level: DEBUG, INFO, WARN, ERROR
# LOG_LEVEL=INFO

# Log sample rate for performance monitoring (0.0 to 1.0)
# LOG_SAMPLE_RATE=1.0

# Suppress build-time logs
# SUPPRESS_BUILD_LOGS=false

# Enable debug logging in production (SECURITY RISK - use only for debugging!)
# ENABLE_DEBUG_LOGS=false

# Enable structured JSON logging (for log aggregation)
# Default: true in production, false in development/test. Explicit value always wins.
# STRUCTURED_LOGGING=

# -----------------------------------------------------------------------------
# OPTIONAL: Platform Detection (Auto-detected, usually no need to set)
# -----------------------------------------------------------------------------
# NODE_ENV=development
# CI=false
# NEXT_RUNTIME=nodejs
# VERCEL_URL=
# NEXT_PUBLIC_VERCEL_URL=
# CF_PAGES=
# CF_WORKER=
# CF_PAGES_URL=
# CF_PAGES_BRANCH_URL=

# -----------------------------------------------------------------------------
# OPTIONAL: Application Version
# -----------------------------------------------------------------------------
# APP_VERSION=1.0.0

# -----------------------------------------------------------------------------
# OPTIONAL: Metrics Configuration
# -----------------------------------------------------------------------------
# Prometheus histogram buckets for HTTP request duration
# METRICS_HISTOGRAM_BUCKETS=0.001,0.005,0.01,0.05,0.1,0.5,1,5

# =============================================================================
# SECURITY NOTES
# =============================================================================
# 1. NEVER commit .env.local to git (already in .gitignore)
# 2. Use different values for development, staging, and production
# 3. Rotate API keys regularly (every 60-90 days)
# 4. Use minimal required permissions for each key
# 5. SUPABASE_SERVICE_ROLE_KEY must NEVER be prefixed with NEXT_PUBLIC_
#    (it would expose admin privileges to the client browser bundle)
# 6. For production, set environment variables in your deployment platform:
#    - Vercel: Project Settings → Environment Variables
#    - Cloudflare: Workers & Pages → Settings → Environment Variables
# =============================================================================