{
  "$schema": "https://opencode.ai/config.json",
  "model": "sabila/cmz",
  "plugin": [
    "oh-my-opencode@latest",
    "opencode-supermemory@latest"
  ],
  "default_agent": "CMZ",
  "agent": {
    "CMZ": {
      "mode": "primary",
      "description": "Primary orchestrating agent",
      "orchestration": true,
      "options": {
        "orchestration": true
      }
    }
  },
  "permission": {
    "external_directory": {
      "/tmp/*": "allow",
      "/var/tmp/*": "allow"
    },
    "glob": "allow"
  },
  "skills": {
    "paths": [
      ".opencode/skills"
    ]
  },
  "snapshot": false,
  "indexing": {
    "enabled": true,
    "provider": "openai-compatible",
    "openai-compatible": {
      "baseUrl": "https://sabila01-router.hf.space/v1",
      "apiKey": "sk-45b3bd7e381fbdbc-jpe9b9-71c1cbff"
    }
  },
  "mcp": {
    "playwright": {
      "enabled": true
    },
    "websearch": {
      "enabled": true
    },
    "context7": {
      "enabled": true
    },
    "github": {
      "enabled": true
    }
  },
  "providers": {
    "sabila": {
      "name": "Sabila Router",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "https://sabila01-router.hf.space/v1",
        "apiKey": "sk-45b3bd7e381fbdbc-jpe9b9-71c1cbff"
      },
      "models": {
        "cmz": {
          "name": "CMZ",
          "modelID": "cmz",
          "limit": {
            "context": 200000,
            "output": 32000
          }
        }
      }
    }
  }
}